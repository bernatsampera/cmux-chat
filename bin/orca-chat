#!/usr/bin/env bash
# orca-chat: read-only chat view that follows the active terminal tab in Orca.
#
#   orca-chat                 start the server, open the chat above this terminal
#   orca-chat --no-open       start the server, print the URL only
#   orca-chat --stop          stop the server that orca-chat started
#
# One chat tab per worktree. Run it again at any time: the same tab stays.
# --agent and --session are accepted, but not used any more.
set -euo pipefail
umask 077

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in /*) ;; *) SELF="$DIR/$SELF" ;; esac
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
STATE="${ORCA_CHAT_STATE_DIR:-$HOME/.local/state/orca-chat}"

export PATH="$PATH:${ORCA_CHAT_DATA_DIR:-$HOME/.local/share/orca-chat}/bun-1.3.14/package/bin:$HOME/.bun/bin:/opt/homebrew/bin"
phase=open open=true
while [ $# -gt 0 ]; do
  case "$1" in
    --no-open) open=false; shift ;;
    --stop) phase=stop; shift ;;
    --agent|--session) shift 2 ;;
    -h|--help) sed -n '2,9p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "orca-chat: unknown option $1" >&2; exit 2 ;;
  esac
done

mkdir -p "$STATE"
chmod 700 "$STATE"
out="$(/usr/bin/lockf -k -t 30 "$STATE/lock" bun "$ROOT/lib/chat.ts" "$phase")"
if [ "$phase" = stop ]; then
  echo "$out"
  exit 0
fi
if $open; then
  bun "$ROOT/lib/place.ts" <<<"$out"
else
  jq -er .url <<<"$out"
fi
