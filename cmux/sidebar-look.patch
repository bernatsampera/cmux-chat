+// --- look (local patch, sidebar-look.patch) --------------------------------------
+// A section (a top-level group that holds projects) is a caption over its
+// projects, a line ends it. A project has an icon with its letter, in its own
+// color, and is a card while something is open in it.
+const PROJECT_COLORS = ["#6AA9FF", "#F1C36B", "#2DD4BF", "#FF8F7A", "#8BE9FD", "#C9A27E", "#B5CC6A", "#A3B8CC"];
+const SECTION_END_HEIGHT = 17;
+const CARD = "#7f7f7f1f";
+const SELECTED = "#6272a4b3";
+const isSection = (node) => !!node && node.depth === 0 && node.children.length > 0;
+// By the order of the names: two projects get the same color only after eight.
+const projectColors = memoJSON(() => {
+  const keys = treeNodes().filter((n) => !isSection(n)).map((n) => n.key).sort();
+  return Object.fromEntries(keys.map((k, i) => [k, PROJECT_COLORS[i % PROJECT_COLORS.length]]));
+});
+const letterIcon = (name) => (/^[a-z0-9]/i.test(name) ? name[0].toLowerCase() + ".square.fill" : "folder.fill");
