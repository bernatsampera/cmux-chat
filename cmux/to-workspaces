#!/usr/bin/env bash
# One workspace per chat again, for projects whose chats are tabs of one workspace.
# Run it in a cmux terminal: to-workspaces [--dry-run] [project]. The agents keep running.
export PATH="$PATH:${ORCA_CHAT_DATA_DIR:-$HOME/.local/share/orca-chat}/bun-1.3.14/package/bin:$HOME/.bun/bin:/opt/homebrew/bin"
exec bun "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/to-workspaces.ts" "$@"
