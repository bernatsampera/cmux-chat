      "description": "Pick a Markdown file of this project and read it next to the chat",
      "keywords": [
        "md",
        "markdown",
        "file",
        "read"
      ],
      "command": "exec __ROOT__/bin/md-open",
      "target": "newTabInCurrentPane",
      "shortcut": "cmd+shift+x"
    }
