{
  "app": {
    "tabBarVisibility": "multiple-tabs",
    "reorderOnNotification": false
  },
  "commands": [
    {
      "name": "Claude + chat",
      "description": "Claude Code below, its read-only chat above",
      "keywords": [
        "claude",
        "chat"
      ],
      "workspace": {
        "layout": {
          "direction": "vertical",
          "split": 0.88,
          "children": [
            {
              "pane": {
                "surfaces": [
                  {
                    "type": "browser",
                    "name": "Chat",
                    "url": "data:text/html;base64,PCFkb2N0eXBlIGh0bWw+PGh0bWwgc3R5bGU9ImJhY2tncm91bmQ6IzFkMWQxZDtjb2xvci1zY2hlbWU6ZGFyayI+"
                  }
                ]
              }
            },
            {
              "pane": {
                "surfaces": [
                  {
                    "type": "terminal",
                    "name": "Claude",
                    "cwd": ".",
                    "command": "__ROOT__/bin/cmux-chat-open --new; CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN=1 claude --plugin-dir __ROOT__/mods/tall-prompt --plugin-dir __ROOT__/mods/live-text",
                    "focus": true
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "name": "Claude + chat: resume",
      "description": "Pick an old conversation of this folder",
      "keywords": [
        "claude",
        "chat"
      ],
      "workspace": {
        "layout": {
          "direction": "vertical",
          "split": 0.88,
          "children": [
            {
              "pane": {
                "surfaces": [
                  {
                    "type": "browser",
                    "name": "Chat",
                    "url": "data:text/html;base64,PCFkb2N0eXBlIGh0bWw+PGh0bWwgc3R5bGU9ImJhY2tncm91bmQ6IzFkMWQxZDtjb2xvci1zY2hlbWU6ZGFyayI+"
                  }
                ]
              }
            },
            {
              "pane": {
                "surfaces": [
                  {
                    "type": "terminal",
                    "name": "Claude",
                    "cwd": ".",
                    "command": "__ROOT__/bin/cmux-chat-open --new; CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN=1 claude --plugin-dir __ROOT__/mods/tall-prompt --plugin-dir __ROOT__/mods/live-text --resume",
                    "focus": true
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "name": "Claude + chat: worktree",
      "description": "Pick a git worktree of this project",
      "keywords": [
        "claude",
        "chat"
      ],
      "workspace": {
        "layout": {
          "direction": "vertical",
          "split": 0.88,
          "children": [
            {
              "pane": {
                "surfaces": [
                  {
                    "type": "browser",
                    "name": "Chat",
                    "url": "data:text/html;base64,PCFkb2N0eXBlIGh0bWw+PGh0bWwgc3R5bGU9ImJhY2tncm91bmQ6IzFkMWQxZDtjb2xvci1zY2hlbWU6ZGFyayI+"
                  }
                ]
              }
            },
            {
              "pane": {
                "surfaces": [
                  {
                    "type": "terminal",
                    "name": "Claude",
                    "cwd": ".",
                    "command": "d=$(git worktree list | fzf | cut -d\" \" -f1) && [ -n \"$d\" ] && cd \"$d\" && { __ROOT__/bin/cmux-chat-open --new; CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN=1 claude --plugin-dir __ROOT__/mods/tall-prompt --plugin-dir __ROOT__/mods/live-text; }",
                    "focus": true
                  }
                ]
              }
            }
          ]
        }
      }
    },
