 const [finishedVersion, setFinishedVersion] = signal("");
 const [recentVersion, setRecentVersion] = signal("");
 const [staleVersion, setStaleVersion] = signal("");
+
+// Last activity (local patch, sidebar-age.patch): the last prompt or the end
+// of an observed turn. cmux forgets latestAt at a restart, so the time is also
+// saved at the end of the workspace description.
+const LAST = /(?:^| \| )last active (\S+)$/;
+const endedAt = new Map(); // id -> wall time of the last observed end of a turn
+const saved = new Map(); // id -> newest time sent to cmux
+const [endedVersion, setEndedVersion] = signal(0);
+const savedTime = (w) => (Date.parse(LAST.exec(w.description ?? "")?.[1] ?? "") || 0) / 1000;
+const knownTime = (w) => Math.max(w.latestAt ?? 0, endedAt.get(w.id) ?? 0, saved.get(w.id) ?? 0, savedTime(w));
+function saveTime(w) {
+  const at = knownTime(w);
+  if (at - Math.max(savedTime(w), saved.get(w.id) ?? 0) < 60) return;
+  saved.set(w.id, at);
+  const text = (w.description ?? "").replace(LAST, "");
+  const stamp = "last active " + new Date(at * 1000).toISOString().slice(0, 16) + "Z";
+  cmux("workspace.action", { action: "set_description", workspace_id: w.id, description: text ? text + " | " + stamp : stamp });
+}
+// Seconds since the last activity, or null. An agent record is the last
+// choice: opening or quitting a session bumps it.
+function idleSeconds(w) {
+  endedVersion();
+  minute();
+  const at = (w && (knownTime(w) || Math.max(0, ...(w.agents || []).map((a) => a.lastActivityAt ?? 0)))) || 0;
+  return at ? Math.max(0, wallNow() - at) : null;
+}
+function ageText(s) {
+  if (s < 60) return "now";
+  if (s < 3600) return Math.floor(s / 60) + "m";
+  if (s < 86400) return Math.floor(s / 3600) + "h";
+  return s < 14 * 86400 ? Math.floor(s / 86400) + "d" : Math.floor(s / (7 * 86400)) + "w";
+}
