#!/usr/bin/env bash
# Moves one chat from Orca to this cmux terminal: move-one <sessionId>
export PATH="$PATH:${ORCA_CHAT_DATA_DIR:-$HOME/.local/share/orca-chat}/bun-1.3.14/package/bin:$HOME/.bun/bin:/opt/homebrew/bin"
here="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
plan="$(bun "$here/../lib/move.ts" one "$@")" || exit 1
{ IFS= read -r dir; args=(); while IFS= read -r arg; do args+=("$arg"); done; } <<<"$plan"
cd -- "$dir" && [ "${#args[@]}" -ge 2 ] || { echo "move-one: cannot open the folder, run: claude --resume $1" >&2; exit 1; }
"$here/../bin/cmux-chat-open"
CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN=1 exec claude "${args[@]}"
