+// --- projects only (local patch, sidebar-projects.patch) -------------------------
+// A chat: an agent, and next to its terminal the page of the chat.
+function hasChat(w) {
+  return !!w && (w.agents || []).length > 0 && (w.tabCount ?? 0) > 1;
+}
+const [projectsOnly, setProjectsOnly] = signal(SETTINGS.projectsOnly);
+const WAITING_PINK = "#FF79C6";
+const CHAT_COLORS = { waiting: WAITING_PINK, working: WORKING_ORANGE, finished: FINISHED_GREEN };
+
+// "working" | "waiting" | "finished" | null
+function chatState(w) {
+  const state = activity(w);
+  if (state !== "working" && w && liveAgents(w).some((a) => a.status === "needs_input")) return "waiting";
+  return state;
+}
+
+// The chats that a header stands for: its own, and collapsed also those below it.
+const ownChats = (node) => [node.anchor, ...node.members].filter((w) => w?.chat).map((w) => w.id);
+function headerChats(node) {
+  if (!node || !projectsOnly()) return [];
+  const below = nodeCollapsed(node) ? descendantsOf(node) : [];
+  return [...new Set([...ownChats(node), ...below.filter((w) => w.chat).map((w) => w.id)])];
+}
+
+// The chat of each group that was open last. The runtime has no storage: a
+// mount forgets it, then the first chat counts.
+const lastOpen = new Map();
+computed(() => {
+  const w = wsSig(selectedId())();
+  if (w?.group && hasChat(w)) lastOpen.set(w.group, w.id);
+});
+
+function openProject(node) {
+  const chats = ownChats(node);
+  const last = lastOpen.get(node.group?.id);
+  selectWorkspace(chats.includes(last) ? last : chats[0] ?? node.anchor?.id);
+}
